<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ subject_line }}</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500&display=swap');
</style>
</head>
<body style="margin:0;padding:0;background-color:#FAF6EF;font-family:'Inter','Helvetica Neue',Helvetica,Arial,sans-serif;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#FAF6EF;padding:40px 0 48px;">
  <tr>
    <td align="center">
      <table role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width:640px;width:100%;">

        <!-- HEADER -->
        <tr>
          <td style="background-color:#1A1210;border-radius:10px 10px 0 0;padding:0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <!-- Logo -->
                <td style="padding:28px 36px 24px;vertical-align:middle;">
                  <img src="data:image/png;base64,{{ logo_b64 }}"
                       alt="GADS" height="56"
                       style="display:block;height:56px;width:auto;background:transparent;">
                </td>
                <!-- Label -->
                <td style="padding:28px 36px 24px;vertical-align:middle;text-align:right;">
                  <span style="font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:#8B7056;">Newsletter</span>
                </td>
              </tr>
              <!-- Accent line -->
              <tr>
                <td colspan="2" style="padding:0;">
                  <div style="height:3px;background-color:#8B7056;"></div>
                </td>
              </tr>
              <!-- Topic headline -->
              <tr>
                <td colspan="2" style="padding:32px 36px 36px;">
                  <h1 style="margin:0;font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:28px;font-weight:700;line-height:1.25;color:#FAF6EF;letter-spacing:-0.3px;">{{ topic }}</h1>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- INTRO -->
        <tr>
          <td style="background-color:#FFFFFF;padding:36px 36px 28px;border-left:1px solid #DEC9AF;border-right:1px solid #DEC9AF;">
            <p style="margin:0;font-family:'Inter','Helvetica Neue',sans-serif;font-size:16px;line-height:1.75;color:#1A1210;">{{ intro }}</p>
          </td>
        </tr>

        <!-- ACCENT DIVIDER -->
        <tr>
          <td style="background-color:#FFFFFF;padding:0 36px;border-left:1px solid #DEC9AF;border-right:1px solid #DEC9AF;">
            <div style="height:1px;background-color:#DEC9AF;"></div>
          </td>
        </tr>

        <!-- SECTIONS -->
        {% for section in sections %}
        <tr>
          <td style="background-color:#FFFFFF;padding:{% if loop.first %}28px{% else %}0{% endif %} 36px 28px;border-left:1px solid #DEC9AF;border-right:1px solid #DEC9AF;">
            <!-- Section heading with Bronze left-border -->
            <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td style="width:3px;background-color:#8B7056;border-radius:2px;">&nbsp;</td>
                <td style="padding:2px 0 2px 14px;">
                  <h2 style="margin:0;font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:18px;font-weight:600;color:#1A1210;letter-spacing:-0.2px;">{{ section.heading }}</h2>
                </td>
              </tr>
            </table>
            <p style="margin:14px 0 0;font-family:'Inter','Helvetica Neue',sans-serif;font-size:15px;line-height:1.8;color:#3A2820;">{{ section.body | replace('\n', '<br>') }}</p>
          </td>
        </tr>
        {% if not loop.last %}
        <tr>
          <td style="background-color:#FFFFFF;padding:0 36px;border-left:1px solid #DEC9AF;border-right:1px solid #DEC9AF;">
            <div style="height:1px;background-color:#FAF6EF;"></div>
          </td>
        </tr>
        {% endif %}
        {% endfor %}

        <!-- CHART BLOCK -->
        <tr>
          <td style="background-color:#1A1210;padding:32px 36px 28px;">
            <p style="margin:0 0 6px;font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:#8B7056;">By The Numbers</p>
            <p style="margin:0 0 20px;font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:16px;font-weight:600;color:#FAF6EF;">Key Statistics</p>
            <img src="data:image/png;base64,{{ chart_b64 }}"
                 alt="Data chart" width="568"
                 style="display:block;width:100%;max-width:568px;border-radius:6px;border:1px solid #221816;">
          </td>
        </tr>

        <!-- FACT CARD BLOCK -->
        <tr>
          <td style="background-color:#1A1210;padding:0 36px 32px;">
            <p style="margin:0 0 6px;font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:#8B7056;">Quick Facts</p>
            <p style="margin:0 0 20px;font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:16px;font-weight:600;color:#FAF6EF;">What You Need to Know</p>
            <img src="data:image/png;base64,{{ factcard_b64 }}"
                 alt="Key facts" width="568"
                 style="display:block;width:100%;max-width:568px;border-radius:6px;border:1px solid #221816;">
          </td>
        </tr>

        <!-- KEY TAKEAWAYS -->
        <tr>
          <td style="background-color:#FFFFFF;padding:32px 36px 36px;border-left:1px solid #DEC9AF;border-right:1px solid #DEC9AF;border-radius:0;">
            <p style="margin:0 0 6px;font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:#8B7056;">Summary</p>
            <h2 style="margin:0 0 20px;font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:18px;font-weight:600;color:#1A1210;">Key Takeaways</h2>
            <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
              {% for takeaway in key_takeaways %}
              <tr>
                <td style="padding:7px 0;vertical-align:top;width:20px;">
                  <div style="width:6px;height:6px;background:#8B7056;border-radius:50%;margin-top:7px;"></div>
                </td>
                <td style="padding:7px 0;font-family:'Inter','Helvetica Neue',sans-serif;font-size:15px;line-height:1.6;color:#1A1210;">{{ takeaway }}</td>
              </tr>
              {% endfor %}
            </table>
          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td style="background-color:#1A1210;border-radius:0 0 10px 10px;padding:32px 36px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td align="center">
                  <img src="data:image/png;base64,{{ logo_b64 }}"
                       alt="GADS" height="64"
                       style="display:block;margin:0 auto;height:64px;width:auto;background:transparent;">
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- OUTER BOTTOM SPACER -->
        <tr><td style="height:1px;"></td></tr>

      </table>
    </td>
  </tr>
</table>

</body>
</html>
